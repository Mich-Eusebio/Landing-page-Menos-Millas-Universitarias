# Variables de entorno para WhatsApp/Kapso
# Agregar estas variables en Vercel: Settings → Environment Variables

# API Key de Kapso (ya existe)
MILLAS_MICHAEL_KAPSO_API_KEY=tu_api_key_aqui

# Phone Number ID de Kapso (ya existe)
MILLAS_MICHAEL_WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui

# Webhook Secret (lo obtienes al crear el webhook en Kapso)
WHATSAPP_WEBHOOK_SECRET=tu_webhook_secret_aqui

# Verify Token para verificación inicial del webhook (tu lo defines)
WHATSAPP_VERIFY_TOKEN=mi_token_secreto_de_verificacion
