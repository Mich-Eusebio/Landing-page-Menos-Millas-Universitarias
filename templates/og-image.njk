<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      width: 1200px;
      height: 630px;
      font-family: 'Inter', sans-serif;
      background: #000;
      overflow: hidden;
    }
    .container {
      width: 100%;
      height: 100%;
      position: relative;
      background-image: url('{{ campusBg }}');
      background-size: cover;
      background-position: center;
    }
    .overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.1) 100%);
    }
    .content {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 40px 50px;
    }
    .left {
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1;
    }
    .title {
      font-size: 36px;
      font-weight: 900;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      line-height: 1.1;
      text-shadow: 0 2px 20px rgba(0,0,0,0.4);
    }
    .day {
      font-size: 56px;
      font-weight: 900;
      color: #fff;
      text-shadow: 0 2px 20px rgba(0,0,0,0.4);
    }
    .subtitle {
      font-size: 16px;
      font-weight: 400;
      color: rgba(255,255,255,0.85);
      line-height: 1.4;
      text-shadow: 0 1px 8px rgba(0,0,0,0.3);
    }
    .cta {
      font-size: 14px;
      font-weight: 700;
      color: rgba(255,255,255,0.9);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-top: 4px;
      text-shadow: 0 1px 8px rgba(0,0,0,0.3);
    }
    .right {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-left: 40px;
    }
    .photo-frame {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      overflow: hidden;
      border: 3px solid rgba(255,255,255,0.6);
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }
    .photo-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="overlay"></div>
    <div class="content">
      <div class="left">
        <div class="title">¿y tu, compraste un día?</div>
        <div class="day">yo tengo el {{ day }}</div>
        <div class="subtitle">
          del camino del primer ciego, dominicano,<br/>
          programador, rumbo a estudiar en EU
        </div>
        <div class="cta">ya yo soy parte de esto</div>
      </div>
      <div class="right">
        <div class="photo-frame">
          <img src="{{ sponsorPhotoUrl }}" alt=""/>
        </div>
        <div class="photo-frame">
          <img src="{{ michaelPhotoUrl }}" alt=""/>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
